# Virtual environment
.venv/

# Generated at runtime. index.db stores absolute paths to the folders being
# cleaned and thumbs/ holds copies of those photos -- this must never be pushed.
cache/

# Benchmark and test-set images: ~1.6 GB, and DIV2K is academic-use only.
# Both are regenerated by eval/make_dataset.py and eval/make_testset.py.
data/

# Internal build notes; contains local machine paths.
PLAN.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Personal photos used for manual testing.
Unsorted/

# Local prep notes, same as PLAN.md.
notes/
